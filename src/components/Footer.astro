---
import links from "@/data/links";
---

<footer class="bg-theme-blue py-8">
  <div class="container flex flex-col items-center md:flex-row">
    <div class="flex flex-1 flex-wrap items-center justify-center gap-12 md:justify-start">
      <img src="/logo-bookmark-footer.svg" alt="Bookmark Landing Page" loading="lazy" />
      <ul class="flex gap-12 text-xs text-theme-gray uppercase">
        {
          links.map((link) => (
            <li>
              <a href={link.url} class="transition-colors duration-300 hover:text-theme-red">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <ul class="mt-12 flex gap-10 md:mt-0">
      <li>
        <a
          href="https://www.facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-theme-white hover:cursor-pointer hover:text-theme-red"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 640 640">
            <path
              fill="currentColor"
              d="M160 96c-35.3 0-64 28.7-64 64v320c0 35.3 28.7 64 64 64h98.2V398.2h-52.8V320h52.8v-33.7c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V236c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V320h83.6l-14.4 78.2H351V544h129c35.3 0 64-28.7 64-64V160c0-35.3-28.7-64-64-64z"
            >
            </path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://www.x.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter/X"
          class="text-theme-white hover:cursor-pointer hover:text-theme-red"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 640 640">
            <path
              fill="currentColor"
              d="M523.4 215.7c.3 4.5.3 9.1.3 13.6c0 138.7-105.6 298.6-298.6 298.6c-59.5 0-114.7-17.2-161.1-47.1c8.4 1 16.6 1.3 25.3 1.3c49.1 0 94.2-16.6 130.3-44.8c-46.1-1-84.8-31.2-98.1-72.8c6.5 1 13 1.6 19.8 1.6c9.4 0 18.8-1.3 27.6-3.6c-48.1-9.7-84.1-52-84.1-103v-1.3c14 7.8 30.2 12.7 47.4 13.3c-28.3-18.8-46.8-51-46.8-87.4c0-19.5 5.2-37.4 14.3-53c51.7 63.7 129.3 105.3 216.4 109.8c-1.6-7.8-2.6-15.9-2.6-24c0-57.8 46.8-104.9 104.9-104.9c30.2 0 57.5 12.7 76.7 33.1c23.7-4.5 46.5-13.3 66.6-25.3c-7.8 24.4-24.4 44.8-46.1 57.8c21.1-2.3 41.6-8.1 60.4-16.2c-14.3 20.8-32.2 39.3-52.6 54.3"
            >
            </path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</footer>
